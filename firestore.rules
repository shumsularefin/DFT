rules_version = '2';
// Progress sync (M6.5): one document per user, users/{uid}/state/main, readable and writable only by
// that signed-in user. Nothing else in the database is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/main {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasAll(['v', 'payload', 'updatedAt'])
        && request.resource.data.v == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.updatedAt is timestamp;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
