# Copy to .env for local work. NEVER commit .env. All values are public build-time settings, none is a secret.
# Site URL used for canonical links and the sitemap
PUBLIC_SITE_URL=http://localhost:4321

# Optional Firebase web config for progress sync. Leave empty to build without sync.
# (Firebase web config is public by design, but it is injected here and never written into the repository.)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloud sessions: Chromium for Playwright and Lighthouse
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
# CHROME_PATH=/opt/pw-browsers/chromium

# Data pipeline (run on the author's machine only, never in CI or the browser):
# MP_API_KEY=
