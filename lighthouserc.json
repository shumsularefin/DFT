{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": "off",
        "document-title": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "link-text": "error",
        "crawlable-anchors": "error",
        "canonical": "error",
        "robots-txt": "error",
        "image-alt": "error",
        "is-crawlable": "off"
      }
    }
  }
}
