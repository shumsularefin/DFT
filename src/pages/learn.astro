---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidedPath from '../components/learn/GuidedPath';
import stations from '../content/learn/stations.json';
import { getScene, lookupStructure } from '../lib/scene/library';
import { structureOf } from '../lib/scene/resolve';
import type { Station } from '../lib/learn/stations';
import '../styles/learning.css';

const list = stations as unknown as Station[];
const ids = new Set<string>();
for (const s of list) {
  if (s.visual.kind === 'scene') ids.add(s.visual.scene);
  if (s.try.kind === 'choice') for (const o of s.try.options) if (o.scene) ids.add(o.scene);
}
const scenes = Object.fromEntries(
  [...ids].map((id) => {
    const spec = getScene(id);
    return [id, { ...spec, structure: structureOf(spec, lookupStructure) }];
  }),
);
---

<BaseLayout
  title="Guided path"
  description="Learn DFT in about fourteen short stations: an atom, the Kohn-Sham idea, the crystal, k-points, bands, spin and your first VASP folder. Each station is one picture, three sentences and one thing to try."
  pageClass="island"
>
  <div class="container learn-page">
    <div class="page-h">
      <div>
        <h1>Guided path</h1>
        <p>
          Fourteen short stations take you from one atom to your first VASP folder. Each has one picture,
          three plain sentences, one thing to try and a link to the full topic. Every picture says what kind
          it is: computed, toy model or illustrative. Nothing here is uploaded or sent anywhere.
        </p>
      </div>
    </div>
    <GuidedPath stations={list} scenes={scenes} client:load />
  </div>
</BaseLayout>
