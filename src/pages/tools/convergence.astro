---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConvergenceTool from '../../components/tools/convergence/ConvergenceTool';
---

<BaseLayout
  title="Convergence plotter"
  description="Plot ENCUT or k-mesh test results, see where the energy stops changing, and export the figure. Runs in your browser."
  pageClass="tool"
>
  <div class="container">
    <h1>Convergence plotter</h1>
    <p>
      Drop the results of a series of runs and see which setting is the cheapest one that has stopped changing
      the energy.
    </p>
    <ConvergenceTool client:load />
  </div>
</BaseLayout>
