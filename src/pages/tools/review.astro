---
// @source S-019, S-041, S-042, S-065
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewTool from '../../components/tools/review/ReviewTool';
---

<BaseLayout
  title="Calculation review"
  description="Drop a VASP calculation folder or zip for local pre-flight and post-flight checks, sourced to the VASP wiki and handbooks, with Markdown export."
  pageClass="tool"
>
  <div class="container">
    <h1>Calculation review (pre-flight and post-flight)</h1>
    <p>
      Drop your VASP input and output files (or a zip archive) to run a sourced pre-flight consistency check
      and post-flight convergence review locally in your browser. Export the transcript as Markdown for your
      lab notebook.
    </p>
    <ReviewTool client:load />
  </div>
</BaseLayout>
