---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MasteryMap from '../components/practice/MasteryMap.astro';
import ProgressPanel from '../components/practice/ProgressPanel';
import SyncPanel from '../components/practice/SyncPanel';
import { readConfig } from '../lib/sync/config';
import { conceptGraph, topicsByConcept } from '../lib/learning/loadBank';
import { moduleName } from '../lib/site';
import '../styles/learning.css';

const syncEnabled = readConfig(import.meta.env) !== null;
const concepts = conceptGraph();
const entries = await getCollection('handbook');
const topics = topicsByConcept(entries);
const links = Object.fromEntries(
  Object.entries(topics).map(([k, v]) => [k, { href: v.href, title: v.title }]),
);
const mods = [...new Set(entries.map((e) => e.data.module))].sort((a, b) => a - b);
const modules = mods.map((m) => entries.filter((e) => e.data.module === m).map((e) => e.id));
const names = mods.map((m) => `${m}. ${moduleName(m)}`);
const published = concepts.filter((c) => c.status === 'published').map((c) => c.id);
const moduleNames = Object.fromEntries(Array.from({ length: 13 }, (_, i) => [i, moduleName(i)]));
---

<BaseLayout
  title="Your progress"
  description="Your mastery map of the handbook's ideas, your practice, and controls to export, import or erase your data. Everything stays in your browser."
  pageClass="island"
>
  <div class="container learn-page">
    <div class="page-h">
      <div>
        <h1>Your progress</h1>
        <p>
          What you have read and practised, on this device only. <a href="/practice/">Practise now</a> or go
          back to the <a href="/handbook/">handbook</a>.
        </p>
      </div>
    </div>
    <div class="js-only stack">
      <ProgressPanel client:load modules={modules} names={names} concepts={published} />
      {syncEnabled && <SyncPanel client:visible />}
    </div>
    <MasteryMap concepts={concepts} topics={links} moduleNames={moduleNames} />
  </div>
  <script>
    import '../scripts/mastery-map';
  </script>
</BaseLayout>
