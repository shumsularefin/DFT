---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/ui/Callout.astro';
import { SITE } from '../lib/site';

// Starting points. Magnetic orderings has no tool yet (M13.2), so it is listed as "coming" rather than linked.
const starts = [
  { href: '/handbook/', label: 'Start learning', note: 'short topics, three reading levels' },
  { href: '/tools/input-builder/', label: 'Build a structure', note: 'POSCAR from lattice and atoms' },
  {
    href: '/tools/input-builder/',
    label: 'Prepare VASP inputs',
    note: 'INCAR, KPOINTS and job script with checks',
  },
  { href: '/tools/kpath/', label: 'k-path', note: 'Brillouin zone and band-structure path' },
  { href: '/tools/convergence/', label: 'Convergence', note: 'plot ENCUT and k-point tests' },
];
---

<BaseLayout>
  <div class="container session">
    <h1 class="sr-only">{SITE.name}</h1>
    <p class="session-name">{SITE.name}</p>
    <button type="button" class="session-prompt js-only" data-palette-open>
      <span class="prompt-mark" aria-hidden="true">
        &gt;
      </span>
      <span>what do you want to learn or build?</span>
      <kbd aria-hidden="true">Ctrl K</kbd>
      <span class="sr-only">Open the command palette</span>
    </button>
    <ul class="starts" aria-label="Starting points">
      {starts.map((x) => (
        <li>
          <a href={x.href}>
            <span>{x.label}</span>
            <small>{x.note}</small>
          </a>
        </li>
      ))}
      <li class="starts-soon">
        <span>Magnetic orderings</span>
        <small>coming: not built yet</small>
      </li>
    </ul>
    <Callout variant="note" title="Under construction">
      Only some topics are written so far and drafts are marked <code>[draft]</code>: they have not yet been
      checked against their sources. Everything runs in your browser and nothing is uploaded.
    </Callout>
  </div>
</BaseLayout>

<style is:global>
  .session-name {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
  .starts-soon {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    min-height: var(--target);
    padding: var(--space-2) var(--space-1);
    color: var(--text-muted);
  }
  .starts-soon::before {
    content: '-';
  }
</style>
