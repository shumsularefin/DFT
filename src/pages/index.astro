---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/ui/Callout.astro';
import { SITE } from '../lib/site';

const starts = [
  {
    href: '/learn/',
    label: 'Guided path',
    note: '14 interactive stations from one atom to your first VASP run',
  },
  { href: '/handbook/', label: 'Handbook', note: '11 modules, 65 topics, three reading levels' },
  {
    href: '/tools/input-builder/',
    label: 'VASP Input Builder',
    note: 'INCAR, KPOINTS, POSCAR, convergence series and job scripts',
  },
  {
    href: '/builder/',
    label: 'Material Builder',
    note: 'Crystal editor, slabs, defects and RDKit molecule builder',
  },
  {
    href: '/studio/',
    label: 'Screening Studio',
    note: 'Filter Materials Project structures and check DFT feasibility',
  },
  {
    href: '/tools/planner/',
    label: 'Research Planner',
    note: 'Goal-to-workflow protocols with downloadable project zips',
  },
  {
    href: '/tools/magnetic/',
    label: 'Magnetic orderings',
    note: 'Collinear FM/AFM supercells, MAGMOM and Heisenberg J fit',
  },
  {
    href: '/tools/kpath/',
    label: 'k-path & Brillouin zone',
    note: 'HPKOT and Setyawan-Curtarolo band paths in 3D',
  },
  {
    href: '/tools/convergence/',
    label: 'Convergence & EOS',
    note: 'Plot ENCUT/k-mesh tests and Birch-Murnaghan fits',
  },
  {
    href: '/tools/tolerance-factor/',
    label: 'Tolerance factors',
    note: 'Goldschmidt t, octahedral mu, Bartel tau and family maps',
  },
  {
    href: '/tools/review/',
    label: 'Calculation review',
    note: 'Pre-flight and post-flight VASP sanity checks',
  },
  { href: '/practice/', label: 'Adaptive practice', note: '316 visual questions with spaced repetition' },
];
---

<BaseLayout>
  <div class="container session">
    <h1 class="sr-only">{SITE.name}</h1>
    <div class="session-head">
      <p class="session-name">{SITE.name}</p>
      <p class="session-tagline">{SITE.tagline}</p>
    </div>
    <button type="button" class="session-prompt js-only" data-palette-open>
      <span class="prompt-mark" aria-hidden="true">
        &#8981;
      </span>
      <span>Search topics, INCAR tags, glossary, or jump to a tool...</span>
      <kbd aria-hidden="true">Ctrl K</kbd>
      <span class="sr-only">Open the command palette</span>
    </button>
    <p class="section-kicker">WORKSPACE MODULES &amp; TOOLS</p>
    <ul class="starts" aria-label="Starting points">
      {starts.map((x) => (
        <li>
          <a href={x.href}>
            <span>{x.label}</span>
            <small>{x.note}</small>
          </a>
        </li>
      ))}
    </ul>
    <Callout variant="note" title="Runs locally in your browser">
      All eleven handbook modules and interactive tools run client-side with zero uploads. Pages marked
      <code>draft</code> await independent source verification.
    </Callout>
  </div>
</BaseLayout>

<style is:global>
  .session-head {
    margin-bottom: var(--space-4);
  }
  .session-name {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .session-tagline {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .section-kicker {
    margin: var(--space-5) 0 var(--space-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
