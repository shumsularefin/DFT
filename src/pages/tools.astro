---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';

const tools = [
  {
    id: 'tolerance',
    title: 'Tolerance-factor explorer',
    text: 'Check whether a chosen set of ions is likely to form a perovskite, with the radii and the formula shown.',
  },
  {
    id: 'input-builder',
    title: 'Input builder',
    text: 'Prepare POSCAR, KPOINTS and INCAR files with plain-language explanations and warnings for risky combinations.',
  },
  {
    id: 'convergence',
    title: 'Convergence plotter',
    text: 'Paste results from a series of runs and see whether the energy has settled.',
  },
  {
    id: 'errors',
    title: 'Error finder',
    text: 'Paste a VASP error message or describe a symptom and see likely causes and fixes, in order.',
  },
  {
    id: 'kpath',
    title: 'Brillouin zone and k-path viewer',
    text: 'See the Brillouin zone of your structure in 3D and export a k-path for a band-structure run.',
  },
  {
    id: 'magnetic',
    title: 'Magnetic configuration tool',
    text: 'Build ferromagnetic and antiferromagnetic orderings for your cell and download POSCAR, MAGMOM and INCAR files.',
  },
  {
    id: 'eos',
    title: 'Equation of state fit',
    text: 'Fit energy-volume points to Birch-Murnaghan or Murnaghan and read V0, the bulk modulus and the lattice constant.',
  },
  {
    id: 'review',
    title: 'Calculation review',
    text: 'Drop VASP inputs and outputs (or a zip) for sourced pre-flight and post-flight checks.',
  },
  {
    id: 'planner',
    title: 'Research planner',
    text: 'Pick a calculation goal to generate a sourced, step-by-step VASP workflow, starter INCARs, methods checklist, and zip.',
  },
  {
    id: 'work-function',
    title: 'Work function and charge difference',
    text: 'Planar and macroscopic averages of LOCPOT, work function Phi = V_vac - E_F, and CHGCAR differences.',
  },
];
const more = [
  {
    id: 'dft-studio',
    title: 'DFT Studio',
    text: 'A VESTA-style 3D crystal viewer and editor with the 350-crystal library, structure checks, INCAR, KPOINTS and POTCAR set-up, a k-point convergence kit and output analysis. It hands structures and results to every tool on this page.',
  },
  {
    id: 'studio',
    title: 'Screening Studio',
    text: 'Explore a table of candidate materials and turn a shortlist into a first project.',
  },
  {
    id: 'builder',
    title: 'Material Builder',
    text: 'Edit a crystal or molecule and export a structure file.',
  },
  {
    id: 'practice',
    title: 'Practice',
    text: 'Short questions that adapt to what you already know and bring topics back at spaced intervals.',
  },
];
---

<BaseLayout
  title="Tools"
  description="Research tools for the DFT Handbook. The input builder, convergence plotter, error finder, k-path tool, magnetic configuration tool, equation-of-state fit and practice are available; the others are planned."
>
  <div class="container">
    <h1>Tools</h1>
    <p>
      These tools run entirely in your browser. The input builder, the convergence plotter, the error finder,
      the k-path tool, the magnetic configuration tool and the equation-of-state fit are available now, and so
      is practice. All research tools, DFT Studio, Screening Studio, Material Builder, and Practice are
      available locally in your browser.
    </p>
    <h2>Research tools</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <Card as="section">
          <h3 class="card-title" id={t.id}>
            {t.title}
          </h3>
          <p>{t.text}</p>
          {t.id === 'tolerance' ? (
            <p>
              <a href="/tools/tolerance-factor/">Open the tolerance-factor explorer</a>
            </p>
          ) : t.id === 'input-builder' ? (
            <p>
              <a href="/tools/input-builder/">Open the input builder</a>
            </p>
          ) : t.id === 'convergence' ? (
            <p>
              <a href="/tools/convergence/">Open the convergence plotter</a>
            </p>
          ) : t.id === 'errors' ? (
            <p>
              <a href="/errors/">Open the error finder</a>
            </p>
          ) : t.id === 'kpath' ? (
            <p>
              <a href="/tools/kpath/">Open the k-path tool</a>
            </p>
          ) : t.id === 'magnetic' ? (
            <p>
              <a href="/tools/magnetic/">Open the magnetic tool</a>
            </p>
          ) : t.id === 'eos' ? (
            <p>
              <a href="/tools/eos/">Open the equation-of-state fit</a>
            </p>
          ) : t.id === 'planner' ? (
            <p>
              <a href="/tools/planner/">Open the research planner</a>
            </p>
          ) : t.id === 'review' ? (
            <p>
              <a href="/tools/review/">Open the calculation review</a>
            </p>
          ) : t.id === 'work-function' ? (
            <p>
              <a href="/tools/work-function/">Open the work-function tool</a>
            </p>
          ) : (
            <p>
              <Badge variant="draft" /> Coming soon
            </p>
          )}
        </Card>
      ))}
    </div>
    <h2>Studios and practice</h2>
    <div class="tool-grid">
      {more.map((t) => (
        <Card as="section">
          <h3 class="card-title" id={t.id}>
            {t.title}
          </h3>
          <p>{t.text}</p>
          {t.id === 'dft-studio' ? (
            <p>
              <a href="/dft-studio/">Open DFT Studio</a>
            </p>
          ) : t.id === 'studio' ? (
            <p>
              <a href="/studio/">Open Screening Studio</a>
            </p>
          ) : t.id === 'builder' ? (
            <p>
              <a href="/builder/">Open Material Builder</a>
            </p>
          ) : t.id === 'practice' ? (
            <p>
              <a href="/practice/">Open practice</a> or see <a href="/progress/">your progress</a>
            </p>
          ) : (
            <p>
              <Badge variant="draft" /> Coming soon
            </p>
          )}
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .tool-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
