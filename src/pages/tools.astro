---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';

interface ToolCard {
  id: string;
  title: string;
  text: string;
  href?: string;
  cta?: string;
}
const tools: ToolCard[] = [
  {
    id: 'tolerance',
    title: 'Tolerance-factor explorer',
    text: 'Check whether a chosen set of ions is likely to form a perovskite, with the radii and the formula shown.',
    href: '/tools/tolerance-factor/',
    cta: 'Open the tolerance-factor explorer',
  },
  {
    id: 'input-builder',
    title: 'Input builder',
    text: 'Prepare POSCAR, KPOINTS and INCAR files with plain-language explanations and warnings for risky combinations.',
    href: '/tools/input-builder/',
    cta: 'Open the input builder',
  },
  {
    id: 'convergence',
    title: 'Convergence plotter',
    text: 'Paste results from a series of runs and see whether the energy has settled.',
    href: '/tools/convergence/',
    cta: 'Open the convergence plotter',
  },
  {
    id: 'kpath',
    title: 'Brillouin zone and k-path viewer',
    text: 'See the Brillouin zone of your structure in 3D and export a k-path for a band-structure run.',
    href: '/tools/kpath/',
    cta: 'Open the k-path tool',
  },
  {
    id: 'errors',
    title: 'VASP error finder',
    text: 'Paste an error message or describe a symptom and see likely causes and what to try, in order.',
    href: '/errors/',
    cta: 'Open the error finder',
  },
];
const more: ToolCard[] = [
  {
    id: 'studio',
    title: 'Screening Studio',
    text: 'Explore a table of candidate materials and turn a shortlist into a first project.',
  },
  {
    id: 'builder',
    title: 'Material Builder',
    text: 'Edit a crystal or molecule and export a structure file.',
  },
  {
    id: 'practice',
    title: 'Practice',
    text: 'Short questions that adapt to what you already know and bring topics back at spaced intervals.',
    href: '/practice/',
    cta: 'Start practising',
  },
];
---

<BaseLayout
  title="Tools"
  description="Research tools for the DFT Handbook. The input builder, convergence plotter, k-path tool and error finder are available; the others are planned."
>
  <div class="container">
    <h1>Tools</h1>
    <p>
      These tools run entirely in your browser. The input builder, the convergence plotter, the k-path tool
      and the error finder are available now. The others are not built yet, so they have no link. Each card
      says what it will do.
    </p>
    <h2>Research tools</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <Card as="section">
          <h3 class="card-title" id={t.id}>
            {t.title}
          </h3>
          <p>{t.text}</p>
          {t.href ? (
            <p>
              <a href={t.href}>{t.cta}</a>
            </p>
          ) : (
            <p>
              <Badge variant="draft" /> Coming soon
            </p>
          )}
        </Card>
      ))}
    </div>
    <h2>Also planned</h2>
    <div class="tool-grid">
      {more.map((t) => (
        <Card as="section">
          <h3 class="card-title" id={t.id}>
            {t.title}
          </h3>
          <p>{t.text}</p>
          {t.href ? (
            <p>
              <a href={t.href}>{t.cta}</a>
            </p>
          ) : (
            <p>
              <Badge variant="draft" /> Coming soon
            </p>
          )}
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .tool-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
