---
import { getCollection, render } from 'astro:content';
import HandbookLayout from '../../../layouts/HandbookLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Why from '../../../components/handbook/Why.astro';
import Intuition from '../../../components/handbook/Intuition.astro';
import Lab from '../../../components/handbook/Lab.astro';
import TheMath from '../../../components/handbook/TheMath.astro';
import TagVisual from '../../../components/handbook/TagVisual.astro';
import InVasp from '../../../components/handbook/InVasp.astro';
import WhatChanges from '../../../components/handbook/WhatChanges.astro';
import Mistakes from '../../../components/handbook/Mistakes.astro';
import Check from '../../../components/handbook/Check.astro';
import GoDeeper from '../../../components/handbook/GoDeeper.astro';
import Level from '../../../components/handbook/Level.astro';
import Term from '../../../components/handbook/Term.astro';
import Cite from '../../../components/handbook/Cite.astro';
import VaspFile from '../../../components/handbook/VaspFile.astro';
import VaspFileExplorer from '../../../components/handbook/VaspFileExplorer.astro';
import PseudopotentialHeader from '../../../components/handbook/PseudopotentialHeader.astro';
import Callout from '../../../components/ui/Callout.astro';
import ErrorFinder from '../../../components/handbook/ErrorFinder.astro';
import Scene from '../../../components/scene/Scene.astro';
import { citeOrder, levelNotes, presentSections, splitId, topicPageClass } from '../../../lib/topic';
import { moduleName } from '../../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('handbook');
  return entries.map((entry) => {
    const { module, topic } = splitId(entry.id);
    return { params: { module, topic }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const body = entry.body ?? '';
Astro.locals.cites = citeOrder(body);
Astro.locals.topic = { id: entry.id, concepts: entry.data.concepts };
const sections = presentSections(body);
const components = {
  Why,
  Intuition,
  Lab,
  TheMath,
  InVasp,
  WhatChanges,
  Mistakes,
  Check,
  GoDeeper,
  Level,
  Term,
  Cite,
  VaspFile,
  VaspFileExplorer,
  PseudopotentialHeader,
  Callout,
  Scene,
  TagVisual,
  ErrorFinder,
};
const statusLabel = { draft: 'Draft', review: 'Awaiting verification', verified: 'Verified' }[
  entry.data.status
];
---

<HandbookLayout
  id={entry.id}
  title={entry.data.title}
  description={entry.data.summary}
  module={entry.data.module}
  moduleTitle={moduleName(entry.data.module)}
  pageClass={topicPageClass(body)}
>
  <div
    class="topic"
    data-pagefind-body
    data-pagefind-meta={`module:${entry.data.module}. ${moduleName(entry.data.module)}`}
  >
    <span hidden data-pagefind-meta={`levels:${levelNotes(body)}`}></span>
    <h1>{entry.data.title}</h1>
    <p class="topic-summary">{entry.data.summary}</p>
    <p class="topic-meta">
      <Badge variant={entry.data.status === 'verified' ? 'verified' : 'draft'} />
      <span class="topic-status">
        {statusLabel}. Updated {entry.data.updated}.
      </span>
    </p>
    <nav class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ul>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.heading}</a>
          </li>
        ))}
      </ul>
    </nav>
    <article class="prose">
      <Content components={components} />
    </article>
  </div>
</HandbookLayout>

<style is:global>
  .topic-status,
  .topic-summary {
    color: var(--text-muted);
  }
  .topic-summary {
    margin-bottom: var(--space-2);
  }
  .topic-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    font-size: var(--step--1);
  }
  .toc {
    margin: 0 0 var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    max-width: var(--measure);
    font-size: var(--step--1);
  }
  .toc-title {
    margin: 0 0 var(--space-1);
    font-weight: 600;
    color: var(--text-muted);
  }
  .toc ul {
    margin: 0;
    padding-left: var(--space-4);
  }
  .toc a {
    display: inline-block;
    padding-block: var(--space-1);
  }
  .prose {
    max-width: var(--measure);
  }
  .prose math {
    font-family: 'Cambria Math', 'STIX Two Math', 'Latin Modern Math', 'Noto Sans Math', math, serif;
    font-size: 1.1em;
  }
  .prose math[display='block'] {
    margin-block: var(--space-4);
  }
  /* Tables of facts must wrap, not scroll sideways, at 360 px (M7.3). */
  .prose table {
    width: 100%;
    border-collapse: collapse;
  }
  .prose th,
  .prose td {
    overflow-wrap: anywhere;
    text-align: left;
    vertical-align: top;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .cite-list {
    padding-left: var(--space-5);
  }
</style>
