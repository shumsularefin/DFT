---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { moduleLabel, splitId } from '../../lib/topic';

const entries = (await getCollection('handbook')).sort(
  (a, b) => a.data.module - b.data.module || a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const groups = new Map<string, typeof entries>();
for (const e of entries) {
  const { module } = splitId(e.id);
  groups.set(module, [...(groups.get(module) ?? []), e]);
}
---

<BaseLayout title="Handbook" description="All handbook topics, by module.">
  <div class="container">
    <h1>Handbook</h1>
    {[...groups].map(([module, topics]) => (
      <section aria-labelledby={`m-${module}`}>
        <h2 id={`m-${module}`}>{moduleLabel(module)}</h2>
        <div class="grid">
          {topics.map((t) => (
            <Card>
              <h3 class="card-title">
                <a href={`/handbook/${t.id}/`}>{t.data.title}</a>
              </h3>
              <p>{t.data.summary}</p>
              <p>
                <Badge variant={t.data.status === 'verified' ? 'verified' : 'draft'} />
              </p>
            </Card>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
