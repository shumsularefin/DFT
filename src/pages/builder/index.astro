<BaseLayout
  title="Material Builder"
  description="Build, edit, validate and export crystal structures (POSCAR, CIF) with live B001-B012 validity checks, supercells, vacancies, substitutions, and tool hand-offs."
  pageClass="tool"
>
  <div class="container">
