---
// @source S-021, S-034, S-042, S-067
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialBuilder from '../../components/tools/builder/MaterialBuilder';
---

<BaseLayout
  title="Material Builder"
  description="Build, edit, validate and export crystals (POSCAR, CIF) and molecules (2D canvas, rough 3D clean-up, XYZ, MOL, POSCAR in a box) locally in your browser."
  pageClass="tool"
>
  <div class="container">
    <h1>Material Builder</h1>
    <p>
      Switch between Crystal mode and Molecule mode (loaded lazily). Validate structures live against B001 to
      B012, export POSCAR/CIF/XYZ/MOL, or hand off directly to the Input Builder, k-path tool, or Magnetic
      configuration tool.
    </p>
    <MaterialBuilder client:load />
  </div>
</BaseLayout>
