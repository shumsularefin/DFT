---
import Section from './Section.astro';
import CheckIsland from '../practice/Check';
import { conceptGraph, questionBank } from '../../lib/learning/loadBank';
import '../practice/practice.css';
import { figuresFor } from '../../lib/visual/figures';

interface Props {
  ids: string[];
}
const { ids } = Astro.props;
const bank = questionBank();
const questions = ids.map((id) => {
  const q = bank.find((x) => x.id === id);
  if (!q) throw new Error(`<Check> lists unknown question id "${id}"`);
  return q;
});
const figures = figuresFor(questions);
const topic = Astro.locals.topic;
const labels = Object.fromEntries(conceptGraph().map((c) => [c.id, c.label]));
---

<Section id="check" heading="Check your understanding">
  <p class="check-lede">
    Answer at your own pace. You can ask for a hint, or say "I am not sure". Your answers stay in this
    browser.
  </p>
  <div class="js-only">
    <CheckIsland
      client:idle
      questions={questions}
      topicId={topic?.id}
      topicConcepts={topic?.concepts ?? []}
      labels={labels}
      figures={figures}
    />
  </div>
  <noscript>
    <p>With JavaScript off, here are the questions with the answers hidden. Open one to see it.</p>
    <ol class="check-static">
      {questions.map((q) => (
        <li>
          {figures[q.id] && (
            <figure class="qc-figure qc-figure-static">
              <div class="qc-figure-flat" set:html={figures[q.id]?.svg} />
              <figcaption>{figures[q.id]?.caption}</figcaption>
            </figure>
          )}
          <p>{q.prompt}</p>
          {(q.type === 'single' || q.type === 'multi') && (
            <ul>
              {q.options.map((o) => (
                <li>{o.text}</li>
              ))}
            </ul>
          )}
          {q.type === 'order' && (
            <ul>
              {q.items.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          )}
          <details>
            <summary>Show the answer</summary>
            {(q.type === 'single' || q.type === 'multi') && (
              <ul>
                {q.options.map((o) => (
                  <li>
                    {o.correct ? 'Correct' : 'Not correct'}: {o.text}. {o.why}
                  </li>
                ))}
              </ul>
            )}
            {q.type === 'numeric' && (
              <p>
                {q.answer}
                {q.unit ? ` ${q.unit}` : ''} (within {q.tolerance}).
              </p>
            )}
            {q.type === 'order' && <p>Order: {q.items.join(', then ')}.</p>}
          </details>
        </li>
      ))}
    </ol>
  </noscript>
</Section>
