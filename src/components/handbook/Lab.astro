---
import Section from './Section.astro';
import Badge from '../ui/Badge.astro';
import CostOfExactness from '../labs/CostOfExactness';
// Labs are registered by id. An id with no component yet shows the placeholder, so topics can be written ahead of their labs.
interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
---

<Section id="lab" heading="Lab">
  {id === 'cost-of-exactness' ? (
    <div data-lab-id={id}>
      <CostOfExactness client:visible />
    </div>
  ) : (
    <div class="lab-placeholder" data-lab-id={id}>
      <p>
        <Badge variant="draft" /> <strong>{title ?? id}</strong>
      </p>
      <p>The interactive lab for this topic is not built yet. It arrives in a later stage.</p>
      <slot />
    </div>
  )}
</Section>

<style is:global>
  .lab-placeholder {
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
  }
  .costlab-methods {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
  }
  .costlab-methods legend {
    font-weight: 600;
    padding-inline: var(--space-1);
  }
  .costlab-method {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    cursor: pointer;
  }
  .costlab-method input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
  }
  .costlab-note {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
