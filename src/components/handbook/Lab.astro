---
import Section from './Section.astro';
import Badge from '../ui/Badge.astro';
import CostOfExactness from '../labs/CostOfExactness';
import BoxLab from '../labs/BoxLab';
import OrbitalsLab from '../labs/OrbitalsLab';
import ExponentialWall from '../labs/ExponentialWall';
import DensityMap from '../labs/DensityMap';
import EncutLab from '../labs/EncutLab';
import KmeshLab from '../labs/KmeshLab';
import BrillouinLab from '../labs/BrillouinLab';
import UnitCellLab from '../labs/UnitCellLab';
// Labs are registered by id. An id with no component yet shows the placeholder, so topics can be written ahead of their labs.
interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
---

<Section id="lab" heading="Lab">
  {id === 'cost-of-exactness' ? (
    <div data-lab-id={id}>
      <CostOfExactness client:visible />
    </div>
  ) : id === 'particle-in-a-box' ? (
    <div data-lab-id={id}>
      <BoxLab client:visible />
    </div>
  ) : id === 'orbitals' ? (
    <div data-lab-id={id}>
      <OrbitalsLab client:visible />
    </div>
  ) : id === 'exponential-wall' ? (
    <div data-lab-id={id}>
      <ExponentialWall client:visible />
    </div>
  ) : id === 'density-as-a-map' ? (
    <div data-lab-id={id}>
      <DensityMap client:visible />
    </div>
  ) : id === 'encut-sphere' ? (
    <div data-lab-id={id}>
      <EncutLab client:visible />
    </div>
  ) : id === 'kpoint-mesh' ? (
    <div data-lab-id={id}>
      <KmeshLab client:visible />
    </div>
  ) : id === 'brillouin-zone' ? (
    <div data-lab-id={id}>
      <BrillouinLab client:visible />
    </div>
  ) : id === 'unit-cell' ? (
    <div data-lab-id={id}>
      <UnitCellLab client:visible />
    </div>
  ) : (
    <div class="lab-placeholder" data-lab-id={id}>
      <p>
        <Badge variant="draft" /> <strong>{title ?? id}</strong>
      </p>
      <p>The interactive lab for this topic is not built yet. It arrives in a later stage.</p>
      <slot />
    </div>
  )}
</Section>

<style is:global>
  .lab-placeholder {
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
  }
  .costlab-methods {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
  }
  .costlab-methods legend {
    font-weight: 600;
    padding-inline: var(--space-1);
  }
  .costlab-method {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    cursor: pointer;
  }
  .costlab-method input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
  }
  .costlab-note {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .orbitals-select {
    margin: var(--space-3) 0;
  }
  .orbitals-select-input {
    min-height: var(--target);
    min-width: 12rem;
    font: inherit;
    padding: 0 var(--space-3);
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .orbitals-select {
    margin: var(--space-3) 0;
  }
  .orbitals-select-input {
    min-height: var(--target);
    min-width: 12rem;
    font: inherit;
    padding: 0 var(--space-3);
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
</style>
