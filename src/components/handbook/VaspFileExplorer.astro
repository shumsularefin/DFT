---
import FileExplorer from '../labs/FileExplorer';
// Clickable, explained view of a VASP file. Never use it for POTCAR content (CLAUDE.md); use <PseudopotentialHeader /> instead.
interface Props {
  kind: 'POSCAR' | 'KPOINTS' | 'INCAR' | 'OSZICAR' | 'OUTCAR-excerpt';
  code: string;
  /** POSCAR only: show the structure beside the file and link atoms to lines. */
  view?: boolean;
  /** Needed for OSZICAR and OUTCAR-excerpt, which have no built-in annotations. */
  annotations?: { line: number; label: string; beginner: string; intermediate: string; pro?: string }[];
}
const { kind, code, view = false, annotations } = Astro.props;
---

<FileExplorer client:visible kind={kind} text={code} view={view} annotations={annotations} />
