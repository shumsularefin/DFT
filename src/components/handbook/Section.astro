---
// One anatomy section with a stable id (docs/CONTENT_GUIDE.md section 3). Wrapped by Why, Intuition, etc.
interface Props {
  id: string;
  heading: string;
}
const { id, heading } = Astro.props;
---

<section class="topic-section card" id={id} aria-labelledby={`${id}-h`}>
  <h2 class="card-h" id={`${id}-h`}>
    {heading}
  </h2>
  <slot />
</section>
