---
import '../ui/disclosure.css';
// Collapsible so a beginner never meets an equation first. Use <Level min="intermediate"> inside for depth.
---

<section class="topic-section card" id="math" aria-labelledby="math-h">
  <h2 class="card-h" id="math-h">
    The math
  </h2>
  <details class="themath disclosure">
    <summary>Show the equations</summary>
    <div class="disclosure-body">
      <slot />
    </div>
  </details>
</section>

<style>
  /* Long equations scroll inside the box instead of pushing the page sideways on a phone. */
  .themath .disclosure-body {
    overflow-x: auto;
  }
</style>
