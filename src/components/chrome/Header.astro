---
import { NAV, SITE } from '../../lib/site';
import LevelSwitch from './LevelSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import ProgressTracker from './ProgressTracker.astro';
import SearchBox from './SearchBox.astro';

interface Props {
  topicIds: string[];
}
const { topicIds } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => {
  const base = href.split('#')[0]!;
  if (href.includes('#')) return false;
  return base === '/' ? path === '/' : path.startsWith(base);
};

/* Line icons (24 px grid, stroke only) for the sidebar navigation. Decorative: the label carries the name. */
const ICONS: Record<string, string> = {
  '/learn/': 'M4 19V6a2 2 0 0 1 2-2h12v13H6a2 2 0 0 0-2 2Zm0 0a2 2 0 0 0 2 2h12M9 8h5',
  '/handbook/': 'M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3Zm18 0h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7Z',
  '/tools/': 'M14.7 6.3a4 4 0 0 0-5.4 5.2L4 16.8V20h3.2l5.3-5.3a4 4 0 0 0 5.2-5.4l-2.4 2.4-2.3-.7-.7-2.3Z',
  '/studio/': 'M12 3 4 7.5v9L12 21l8-4.5v-9Zm0 0v18M4 7.5l8 4.5 8-4.5',
  '/builder/': 'M4 4h7v7H4Zm9 0h7v7h-7ZM4 13h7v7H4Zm9 3.5h7M16.5 13v7',
  '/practice/': 'M9 11l3 3 8-8M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9',
};
---

<header class="site-header">
  <div class="header-row">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle>
        <ellipse cx="12" cy="12" rx="9.5" ry="4"></ellipse>
        <ellipse cx="12" cy="12" rx="9.5" ry="4" transform="rotate(60 12 12)"></ellipse>
        <ellipse cx="12" cy="12" rx="9.5" ry="4" transform="rotate(-60 12 12)"></ellipse>
      </svg>
      <span>{SITE.name}</span>
    </a>
    <button
      type="button"
      class="menu-btn js-only"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-button
    >
      Menu
    </button>
    <div class="site-menu" id="site-menu" data-menu>
      <p class="side-label" aria-hidden="true">
        Explore
      </p>
      <nav aria-label="Main">
        <ul class="nav-list">
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONS[item.href] ?? 'M5 12h14'} />
                </svg>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="side-foot">
        <div class="side-search">
          <SearchBox />
        </div>
        <p class="side-label" aria-hidden="true">
          Your study
        </p>
        <div class="header-tools">
          <LevelSwitch />
          <div class="side-row">
            <ProgressTracker ids={topicIds} />
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* App shell: a left sidebar on wide screens (64rem and up), a top bar with a drawer below that.
     Layout follows calm workspace apps: quiet chrome, one accent, the reading column in the centre. */
  .site-header {
    background: var(--sidebar);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-2);
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .brand-mark {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .brand-mark circle {
    fill: var(--accent);
    stroke: none;
  }
  .menu-btn {
    margin-left: auto;
    min-height: var(--target);
    min-width: var(--target);
    padding: 0 var(--space-4);
    font: inherit;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .site-menu {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    max-height: calc(100dvh - 3.5rem);
    overflow-y: auto;
  }
  html.js .site-menu:not([data-open]) {
    display: none;
  }
  .side-label {
    margin: var(--space-3) 0 var(--space-1);
    padding: 0 var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    max-width: none;
  }
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .nav-list li {
    margin: 0;
  }
  .nav-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    padding: 0 var(--space-3);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
    transition: background-color var(--dur-fast);
  }
  .nav-list a:hover {
    background: color-mix(in srgb, var(--text) 7%, transparent);
  }
  .nav-list a[aria-current='page'] {
    background: var(--surface);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .nav-icon {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav-list a[aria-current='page'] .nav-icon {
    stroke: var(--accent);
  }
  .side-search {
    padding: 0 var(--space-1);
  }
  .header-tools {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 var(--space-1);
  }
  .side-row {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .side-row .progress-tracker {
    flex: 1;
  }
  .side-row .progress-btn {
    width: 100%;
  }
  .header-tools .level-switch {
    display: flex;
  }
  .header-tools .level-switch button {
    flex: 1 1 auto;
    padding: 0 var(--space-2);
    font-size: var(--step--1);
  }
  @media (min-width: 64rem) {
    body {
      padding-inline-start: var(--sidebar-w);
    }
    .site-header {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-w);
      border-bottom: 0;
      border-inline-end: 1px solid var(--border);
    }
    .header-row {
      height: 100%;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      padding: var(--space-3) var(--space-3) var(--space-3);
    }
    .menu-btn {
      display: none;
    }
    html.js .site-menu:not([data-open]),
    .site-menu {
      display: flex;
      flex: 1;
      flex-basis: auto;
      max-height: none;
      min-height: 0;
      padding-bottom: 0;
    }
    .side-foot {
      margin-top: auto;
      padding-top: var(--space-3);
      border-top: 1px solid var(--border);
    }
    .site-header .search-results {
      position: fixed;
      inset-inline-start: calc(var(--sidebar-w) + 0.5rem);
      inset-inline-end: auto;
      top: auto;
      bottom: 0.75rem;
    }
  }
  html:not(.js) .js-only {
    display: none !important;
  }
</style>

<style is:global>
  .level-switch button,
  .progress-btn,
  .nav-list a {
    white-space: nowrap;
  }
</style>
