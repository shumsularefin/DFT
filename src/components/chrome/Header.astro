---
import { NAV, NAV_GROUPS, SITE } from '../../lib/site';
import LevelSwitch from './LevelSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import ProgressTracker from './ProgressTracker.astro';
import SearchBox from './SearchBox.astro';

interface Props {
  topicIds: string[];
  /** Page title, shown in the top bar next to its section. */
  title?: string;
}
const { topicIds, title } = Astro.props;
const path = Astro.url.pathname;
// The current link is the longest href the path starts with, so /tools/kpath/ marks k-path, not All tools.
const currentHref = NAV.map((i) => i.href)
  .filter((h) => path.startsWith(h))
  .sort((a, b) => b.length - a.length)[0];
const section = NAV_GROUPS.find((g) => g.items.some((i) => i.href === currentHref))?.label;

/* Line icons (24 px grid, stroke only). Decorative: the label carries the name. */
const ICONS: Record<string, string> = {
  path: 'M6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12-12a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 18h5a3 3 0 0 0 0-6h-2a3 3 0 0 1 0-6h5',
  book: 'M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3Zm18 0h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7Z',
  check: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 9 3 3 5-6',
  trend: 'm3 17 6-6 4 4 8-8M15 7h6v6',
  cube: 'M21 7.5 12 3 3 7.5v9L12 21l9-4.5ZM3 7.5l9 4.5 9-4.5M12 12v9',
  file: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8Zm0 0v5h5M9 13h6M9 17h6',
  filter: 'M4 6h16M7 12h10M10 18h4',
  chart: 'M3 3v18h18M7 15l4-5 3 3 5-6',
  kpath: 'M4 19 9 6l5 9 6-10',
  magnet: 'M6 3v8a6 6 0 0 0 12 0V3h-4v8a2 2 0 0 1-4 0V3ZM6 7h4m4 0h4',
  search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm9 2-3.5-3.5',
  grid: 'M4 4h7v7H4Zm9 0h7v7h-7ZM4 13h7v7H4Zm9 0h7v7h-7Z',
};
---

<header class="site-header">
  <div class="header-row">
    <a class="brand" href="/">
      <span class="brand-logo" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="1.6"></circle>
          <ellipse cx="12" cy="12" rx="9.5" ry="3.8"></ellipse>
          <ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(60 12 12)"></ellipse>
          <ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(-60 12 12)"></ellipse>
        </svg>
      </span>
      <span>{SITE.name}</span>
    </a>
    <button
      type="button"
      class="menu-btn js-only"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-button
    >
      Menu
    </button>
    <div class="site-menu" id="site-menu" data-menu>
      <nav aria-label="Main" class="side-nav">
        {NAV_GROUPS.map((g) => (
          <>
            <p class="side-label" aria-hidden="true">
              {g.label}
            </p>
            <ul class="nav-list">
              {g.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ICONS[item.icon]} />
                    </svg>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))}
      </nav>
      <div class="topbar">
        <p class="topbar-crumb">
          {section && <span class="topbar-section">{section}</span>}
          {section && title && (
            <span class="topbar-sep" aria-hidden="true">
              /
            </span>
          )}
          {title && <b>{title}</b>}
        </p>
        <div class="topbar-tools">
          <LevelSwitch />
          <div class="topbar-search">
            <SearchBox />
          </div>
          <ThemeToggle />
        </div>
      </div>
      <div class="side-foot">
        <ProgressTracker ids={topicIds} />
        <p class="side-note">
          <span class="side-dot" aria-hidden="true"></span>Runs locally, no uploads
        </p>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* App shell (D-105): a fixed left sidebar and a fixed top bar on wide screens (64rem and up),
     a top bar with a drawer below that. Quiet chrome, one accent, the work in the centre. */
  .site-header {
    background: var(--sidebar);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    padding: 0 var(--space-2);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .brand-logo {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    background: var(--accent);
  }
  .brand-logo svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--accent-contrast);
    stroke-width: 1.5;
  }
  .brand-logo circle {
    fill: var(--accent-contrast);
    stroke: none;
  }
  .menu-btn {
    margin-left: auto;
    min-height: var(--target);
    min-width: var(--target);
    padding: 0 var(--space-4);
    font: inherit;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .site-menu {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    max-height: calc(100dvh - 3.5rem);
    overflow-y: auto;
  }
  html.js .site-menu:not([data-open]) {
    display: none;
  }
  .side-label {
    margin: var(--space-4) 0 var(--space-1);
    padding: 0 0.625rem;
    font-size: 0.72rem;
    font-weight: 500;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    max-width: none;
  }
  .side-nav > .side-label:first-child {
    margin-top: var(--space-2);
  }
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .nav-list li {
    margin: 0;
  }
  .nav-list a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: var(--target);
    padding: 0 0.625rem;
    font-size: var(--step-0);
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .nav-list a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .nav-list a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }
  .nav-icon {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav-list a[aria-current='page'] .nav-icon {
    stroke: var(--accent);
  }
  /* Top bar: section and page title, reading level, search, theme. In the drawer below 64rem. */
  .topbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-1) 0;
    border-top: 1px solid var(--border);
  }
  .topbar-crumb {
    display: none;
  }
  .topbar-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .topbar-search {
    flex: 1 1 10rem;
  }
  .topbar-tools .level-switch button {
    min-height: 1.625rem;
    min-width: 0;
    padding: 0 0.625rem;
    font-size: var(--step--1);
  }
  .topbar-tools .theme-toggle {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    color: var(--text-muted);
  }
  .topbar-tools .theme-toggle:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .topbar-search input {
    background: var(--surface);
    border-color: var(--border);
    box-shadow: none;
    font-size: var(--step--1);
  }
  .side-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-1) 0;
  }
  .side-foot .progress-btn {
    width: 100%;
  }
  .side-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0 var(--space-2);
    font-size: 0.8rem;
    color: var(--text-muted);
    max-width: none;
  }
  .side-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }
  @media (min-width: 64rem) {
    body {
      padding-inline-start: var(--sidebar-w);
      padding-top: var(--topbar-h);
    }
    .site-header {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-w);
      border-bottom: 0;
      border-inline-end: 1px solid var(--border);
    }
    .header-row {
      height: 100%;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      padding: 0 var(--space-2) var(--space-3);
    }
    .brand {
      min-height: var(--topbar-h);
      margin: 0 calc(-1 * var(--space-2)) var(--space-1);
      padding: 0 var(--space-4);
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
    .menu-btn {
      display: none;
    }
    html.js .site-menu:not([data-open]),
    .site-menu {
      display: flex;
      flex: 1;
      flex-basis: auto;
      max-height: none;
      min-height: 0;
      padding-bottom: 0;
    }
    .side-nav {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
    }
    .topbar {
      position: fixed;
      z-index: 25;
      top: 0;
      inset-inline: var(--sidebar-w) 0;
      height: var(--topbar-h);
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin: 0;
      padding: 0 var(--space-5);
      background: var(--bg);
      gap: var(--space-3);
      border-top: 0;
      border-bottom: 1px solid var(--border);
    }
    .topbar-crumb {
      display: flex;
      gap: var(--space-2);
      min-width: 0;
      margin: 0;
      font-size: var(--step-0);
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: none;
    }
    .topbar-crumb b {
      font-weight: 500;
      color: var(--text);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .topbar-tools {
      flex-wrap: nowrap;
      flex: none;
    }
    .topbar-search {
      flex: 0 1 14rem;
    }
    .side-foot {
      border-top: 1px solid var(--border);
    }
    .topbar .search-results {
      inset-inline: auto 0;
    }
  }
  html:not(.js) .js-only {
    display: none !important;
  }
  .level-switch button,
  .progress-btn {
    white-space: nowrap;
  }
</style>
