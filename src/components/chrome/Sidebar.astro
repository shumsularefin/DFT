---
import { moduleName } from '../../lib/site';

interface Topic {
  id: string;
  title: string;
}
interface Props {
  groups: { module: number; topics: Topic[] }[];
  currentId?: string;
  currentModule?: number;
}
const { groups, currentId, currentModule } = Astro.props;
---

<nav class="sidebar" aria-label="Handbook modules">
  <details class="sidebar-details" data-sidebar>
    <summary>All topics</summary>
    <ul class="sidebar-modules">
      {groups.map((g) => (
        <li>
          <details open={g.module === currentModule} data-module-details>
            <summary>
              <span>
                {g.module}. {moduleName(g.module)}
              </span>
              <span
                class="module-pct"
                data-module-pct={g.module}
                data-module-ids={g.topics.map((t) => t.id).join(',')}
              />
            </summary>
            <ul>
              {g.topics.map((t) => (
                <li data-topic-item={t.id}>
                  <a href={`/handbook/${t.id}/`} aria-current={t.id === currentId ? 'page' : undefined}>
                    {t.title}
                  </a>
                  <span class="tick" hidden>
                    <span aria-hidden="true">✓</span>
                    <span class="sr-only">completed</span>
                  </span>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </details>
</nav>

<style is:global>
  .sidebar summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .sidebar summary:hover,
  .sidebar li[data-topic-item] a:hover {
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .sidebar ul ul {
    margin-inline-start: var(--space-3);
    padding-inline-start: var(--space-2);
    border-inline-start: 1px solid var(--border);
  }
  .sidebar li[data-topic-item] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .sidebar li[data-topic-item] a {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: var(--target);
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    font-size: var(--step--1);
    line-height: 1.3;
    text-decoration: none;
    color: var(--text-muted);
  }
  .sidebar li[data-topic-item] a[aria-current='page'] {
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .sidebar .tick {
    color: var(--ok);
  }
  .module-pct {
    color: var(--text-muted);
    font-weight: 400;
    font-size: var(--step--1);
  }
</style>
