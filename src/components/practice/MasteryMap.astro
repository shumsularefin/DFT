---
import type { Concept } from '../../lib/learning/graph';
import { layeredLayout } from '../../lib/learning/layout';

interface Props {
  concepts: Concept[];
  topics: Record<string, { href: string; title: string }>;
  moduleNames: Record<number, string>;
}
const { concepts, topics, moduleNames } = Astro.props;
// The layered layout gives every idea its depth in the prerequisite graph. The map shows one row per
// module and, within a row, the ideas in that build order, so nothing needs lines that cross.
const layout = layeredLayout(concepts);
const order = new Map(layout.nodes.map((n) => [n.id, n.layer * 1000 + n.row]));
const byId = new Map(concepts.map((c) => [c.id, c]));
const published = concepts.filter((c) => c.status === 'published');
const ids = new Set(published.map((c) => c.id));
const mods = [...new Set(published.map((c) => c.module))].sort((a, b) => a - b);
const inModule = (m: number) =>
  published.filter((c) => c.module === m).sort((a, b) => order.get(a.id)! - order.get(b.id)!);
const modName = (m: number) => moduleNames[m] ?? `Module ${m}`;
---

<section aria-labelledby="map-h" class="mastery card">
  <h2 id="map-h" class="card-h">
    Mastery map
  </h2>
  <p>
    One row per module, in reading order. In each row the ideas run in the order they build on each other.
    Point at an idea, or move to it with the keyboard, to light up the ideas it builds on (solid outline) and
    the ideas that build on it (dashed outline). Shape and text show your state, not colour alone: an open
    circle is not started, a hatched diamond is learning, a solid square is mastered. The states are estimates
    from your answers on this device.
  </p>
  <p data-map-summary class="map-summary">
    {published.length} ideas in total.
  </p>
  <div class="map-filter js-only">
    <label for="map-module">Show</label>
    <select id="map-module" data-map-filter>
      <option value="all">All modules</option>
      {mods.map((m) => (
        <option value={m}>{`${m}. ${modName(m)}`}</option>
      ))}
    </select>
  </div>
  <svg class="map-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <pattern
        id="map-hatch"
        width="4"
        height="4"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect width="4" height="4" fill="var(--surface)"></rect>
        <line x1="0" y1="0" x2="0" y2="4" stroke="var(--accent)" stroke-width="2"></line>
      </pattern>
    </defs>
  </svg>
  <div class="map-lanes" role="region" aria-label="Mastery map, one row per module" data-map-scroll>
    {mods.map((m) => (
      <div class="map-lane" data-module-lane={m}>
        <div class="lane-h">
          <span class="lane-n" aria-hidden="true">
            {m}
          </span>
          <span class="lane-name">{modName(m)}</span>
          <span class="lane-count" data-lane-count>
            {`${inModule(m).length} ideas`}
          </span>
        </div>
        <div class="lane-nodes">
          {inModule(m).map((c) => {
            const t = topics[c.id];
            const attrs = {
              'aria-label': `${c.label}, module ${c.module}, not started`,
              title: c.summary,
              'data-concept': c.id,
              'data-module': c.module,
              'data-pre': c.prerequisites.filter((p) => ids.has(p)).join(' '),
              'data-state': 'new',
              class: 'map-node',
            };
            const inner = (
              <>
                <svg class="shape-icon" viewBox="0 0 18 18" width="14" height="14" aria-hidden="true">
                  <circle class="shape shape-new" cx="9" cy="9" r="6.5" />
                  <path class="shape shape-learning" d="M9 1.5 L16.5 9 L9 16.5 L1.5 9 Z" />
                  <rect class="shape shape-mastered" x="2.5" y="2.5" width="13" height="13" />
                </svg>
                <span class="node-label">{c.label}</span>
              </>
            );
            return t ? (
              <a href={t.href} {...attrs}>
                {inner}
              </a>
            ) : (
              <span role="img" {...attrs}>
                {inner}
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <h2 id="list-h" class="card-h map-list-h">
    The same map as a list
  </h2>
  <div class="map-lists">
    {mods.map((m) => (
      <section class="map-list" data-module-section={m} aria-labelledby={`ml-${m}`}>
        <h3 id={`ml-${m}`}>{`${m}. ${modName(m)}`}</h3>
        <ul>
          {inModule(m).map((c) => (
            <li data-concept={c.id} data-state="new" data-module={c.module}>
              {topics[c.id] ? <a href={topics[c.id]!.href}>{c.label}</a> : <span>{c.label}</span>}
              <span class="map-state"> (not started)</span>
              {c.prerequisites.length > 0 && (
                <span class="map-pre">
                  {' '}
                  builds on {c.prerequisites.map((p) => byId.get(p)?.label ?? p).join(', ')}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style is:global>
  .map-defs {
    position: absolute;
  }
  .map-lanes {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .map-lane {
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3);
  }
  .map-lane + .map-lane {
    border-top: 1px solid var(--border);
  }
  .map-lane[hidden] {
    display: none;
  }
  .lane-h {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-2);
    align-items: baseline;
    padding-top: 0.25rem;
  }
  .lane-n {
    grid-row: span 2;
    min-width: 1.75rem;
    padding: 0.1rem 0.4rem;
    font: 600 var(--step--1) var(--font-mono);
    text-align: center;
    color: var(--accent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .lane-name {
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.3;
  }
  .lane-count {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .lane-nodes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .map-node {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.2rem 0.65rem 0.2rem 0.5rem;
    font-size: var(--step--1);
    line-height: 1.25;
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition:
      opacity 0.12s,
      border-color 0.12s;
  }
  a.map-node:hover {
    border-color: var(--accent);
  }
  a.map-node:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .map-node[data-state='mastered'] {
    border-color: var(--accent);
  }
  .shape-icon {
    flex: none;
    display: block;
  }
  .shape {
    display: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .shape-new {
    fill: none;
    stroke-dasharray: 3 2;
  }
  .shape-learning {
    fill: url(#map-hatch);
  }
  .shape-mastered {
    fill: var(--accent);
  }
  [data-state='new'] .shape-new,
  [data-state='learning'] .shape-learning,
  [data-state='mastered'] .shape-mastered {
    display: inline;
  }
  /* Hover or focus on an idea: what it builds on gets a solid outline, what builds on it a dashed one. */
  .map-lanes[data-focus] .map-node:not([data-rel]) {
    opacity: 0.4;
  }
  .map-node[data-rel='self'] {
    border-color: var(--focus);
    box-shadow: 0 0 0 1px var(--focus);
  }
  .map-node[data-rel='pre'] {
    border: 2px solid var(--accent);
  }
  .map-node[data-rel='post'] {
    border: 2px dashed var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .map-node {
      transition: none;
    }
  }
  .map-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-3) 0;
  }
  .map-filter select {
    min-width: 0;
    max-width: 100%;
    min-height: var(--target);
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0 var(--space-3);
  }
  .mastery {
    margin-top: var(--space-4);
  }
  .mastery > p {
    max-width: 100ch;
  }
  .map-list-h {
    margin-top: var(--space-5);
  }
  /* Masonry by columns: sections of very different lengths pack without the ragged gaps of a grid. */
  .map-lists {
    columns: 20rem;
    column-gap: var(--space-3);
  }
  .map-list {
    break-inside: avoid;
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .map-list h3 {
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-2);
    font-size: var(--step--1);
    border-bottom: 1px solid var(--border);
  }
  .map-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }
  .map-list li {
    margin: 0;
    padding: 0.3rem 0;
    line-height: 1.4;
  }
  .map-list li + li {
    border-top: 1px dashed var(--border);
  }
  .map-list li a {
    font-weight: 500;
  }
  .map-pre,
  .map-state {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .map-pre {
    display: block;
  }
  .map-summary {
    color: var(--text-muted);
  }
</style>
