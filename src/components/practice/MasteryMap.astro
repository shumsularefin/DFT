---
import type { Concept } from '../../lib/learning/graph';
import {
  FLOW_NODE_H,
  FLOW_NODE_W,
  flowEdgePath,
  flowLayout,
  layeredLayout,
  wrapLabel,
} from '../../lib/learning/layout';

interface Props {
  concepts: Concept[];
  topics: Record<string, { href: string; title: string }>;
  moduleNames: Record<number, string>;
}
const { concepts, topics, moduleNames } = Astro.props;
const layout = layeredLayout(concepts);
// Laid out for a 1200 px wide map at build time; scripts/mastery-map.ts lays it out again for the width
// the map really has, so it fits without a sideways scrollbar.
const flow = flowLayout(layout.nodes, 1200);
const byId = new Map(concepts.map((c) => [c.id, c]));
const base = new Map(layout.nodes.map((n) => [n.id, n]));
const pos = new Map(flow.nodes.map((n) => [n.id, n]));
const mods = [...new Set(concepts.filter((c) => c.status === 'published').map((c) => c.module))].sort(
  (a, b) => a - b,
);
const published = concepts.filter((c) => c.status === 'published');
const mid = FLOW_NODE_H / 2;
---

<section aria-labelledby="map-h" class="mastery card">
  <h2 id="map-h" class="card-h">
    Mastery map
  </h2>
  <p>
    Each mark is one idea. Ideas to its left are the basics it builds on. Shape and text show your state, not
    colour alone: an open circle is not started, a hatched diamond is learning, a solid square is mastered.
    The states are estimates from your answers on this device.
  </p>
  <p data-map-summary class="map-summary">
    {published.length} ideas in total.
  </p>
  <div class="map-filter js-only">
    <label for="map-module">Show</label>
    <select id="map-module" data-map-filter>
      <option value="all">All modules</option>
      {mods.map((m) => (
        <option value={m}>{`${m}. ${moduleNames[m] ?? `Module ${m}`}`}</option>
      ))}
    </select>
  </div>
  <div
    class="map-scroll"
    tabindex="0"
    role="region"
    aria-label="Mastery map. The same information is in the list below."
    data-map-scroll
  >
    <svg
      class="map-svg"
      width={flow.width}
      height={flow.height}
      viewBox={`0 0 ${flow.width} ${flow.height}`}
      role="group"
      aria-label="Concept graph"
    >
      <defs>
        <pattern
          id="map-hatch"
          width="6"
          height="6"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <rect width="6" height="6" fill="var(--surface)"></rect>
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--accent)" stroke-width="3"></line>
        </pattern>
      </defs>
      <g class="map-edges" aria-hidden="true">
        {layout.edges.map((e) => (
          <path
            d={flowEdgePath(pos.get(e.from)!, pos.get(e.to)!)}
            data-from={e.from}
            data-to={e.to}
            data-from-module={byId.get(e.from)!.module}
            data-to-module={byId.get(e.to)!.module}
          />
        ))}
      </g>
      {flow.nodes.map((n) => {
        const c = byId.get(n.id)!;
        const t = topics[c.id];
        const lines = wrapLabel(c.label);
        // Node content is drawn at the origin; the node's transform places it.
        const inner = (
          <>
            <title>{`${c.label}. ${c.summary}`}</title>
            <rect class="node-hit" x="0" y="0" width={FLOW_NODE_W} height={FLOW_NODE_H} rx="4"></rect>
            <circle class="shape shape-new" cx="14" cy={mid} r="7"></circle>
            <path class="shape shape-learning" d={`M14 ${mid - 8} l8 8 l-8 8 l-8 -8 z`}></path>
            <rect class="shape shape-mastered" x="7" y={mid - 7} width="14" height="14"></rect>
            <svg x="30" y="0" width={FLOW_NODE_W - 34} height={FLOW_NODE_H}>
              <text x="0" y={lines.length === 1 ? mid + 4 : mid - 3} class="node-label">
                {lines.map((line, i) => (
                  <tspan x="0" dy={i === 0 ? 0 : 14}>
                    {line}
                  </tspan>
                ))}
              </text>
            </svg>
          </>
        );
        const place = {
          transform: `translate(${n.x} ${n.y})`,
          'data-layer': base.get(n.id)!.layer,
          'data-row': base.get(n.id)!.row,
        };
        const label = `${c.label}, module ${c.module}, not started`;
        return t ? (
          <a
            href={t.href}
            {...place}
            aria-label={label}
            data-concept={c.id}
            data-module={c.module}
            data-state="new"
            class="map-node"
          >
            {inner}
          </a>
        ) : (
          <g
            role="img"
            {...place}
            aria-label={label}
            data-concept={c.id}
            data-module={c.module}
            data-state="new"
            class="map-node"
          >
            {inner}
          </g>
        );
      })}
    </svg>
  </div>

  <h2 id="list-h" class="card-h map-list-h">
    The same map as a list
  </h2>
  <div class="map-lists">
    {mods.map((m) => (
      <section class="map-list" data-module-section={m} aria-labelledby={`ml-${m}`}>
        <h3 id={`ml-${m}`}>{`${m}. ${moduleNames[m] ?? `Module ${m}`}`}</h3>
        <ul>
          {published
            .filter((c) => c.module === m)
            .map((c) => (
              <li data-concept={c.id} data-state="new" data-module={c.module}>
                {topics[c.id] ? <a href={topics[c.id]!.href}>{c.label}</a> : <span>{c.label}</span>}
                <span class="map-state"> (not started)</span>
                {c.prerequisites.length > 0 && (
                  <span class="map-pre">
                    {' '}
                    builds on {c.prerequisites.map((p) => byId.get(p)?.label ?? p).join(', ')}
                  </span>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style is:global>
  .map-scroll {
    overflow-x: auto;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .map-svg {
    display: block;
  }
  .map-edges path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
    opacity: 0.55;
  }
  .map-node .node-hit {
    fill: transparent;
  }
  .map-node:hover .node-hit,
  a.map-node:focus-visible .node-hit {
    fill: var(--surface-2);
    stroke: var(--focus);
    stroke-width: 2;
  }
  a.map-node:focus-visible {
    outline: none;
  }
  .node-label {
    fill: var(--text);
    font: 12px var(--font-mono);
  }
  .shape {
    display: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .shape-new {
    fill: none;
    stroke-dasharray: 3 2;
  }
  .shape-learning {
    fill: url(#map-hatch);
  }
  .shape-mastered {
    fill: var(--accent);
  }
  [data-state='new'] > .shape-new,
  [data-state='learning'] > .shape-learning,
  [data-state='mastered'] > .shape-mastered {
    display: inline;
  }
  .map-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-3) 0;
  }
  .map-filter select {
    min-width: 0;
    max-width: 100%;
    min-height: var(--target);
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0 var(--space-3);
  }
  .mastery {
    margin-top: var(--space-4);
  }
  .mastery > p {
    max-width: 90ch;
  }
  .map-list-h {
    margin-top: var(--space-5);
  }
  .map-lists {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }
  .map-list {
    padding: var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .map-list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
  }
  .map-list ul {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--step--1);
  }
  .map-list li {
    margin: var(--space-1) 0;
  }
  .map-pre,
  .map-state {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .map-summary {
    color: var(--text-muted);
  }
</style>
