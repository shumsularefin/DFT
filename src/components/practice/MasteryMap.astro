---
import type { Concept } from '../../lib/learning/graph';
import { COL_W, NODE_W, ROW_H, layeredLayout } from '../../lib/learning/layout';

interface Props {
  concepts: Concept[];
  topics: Record<string, { href: string; title: string }>;
  moduleNames: Record<number, string>;
}
const { concepts, topics, moduleNames } = Astro.props;
const layout = layeredLayout(concepts);
const byId = new Map(concepts.map((c) => [c.id, c]));
const pos = new Map(layout.nodes.map((n) => [n.id, n]));
const mods = [...new Set(concepts.filter((c) => c.status === 'published').map((c) => c.module))].sort(
  (a, b) => a - b,
);
const published = concepts.filter((c) => c.status === 'published');
const mid = ROW_H / 2;
---

<section aria-labelledby="map-h" class="mastery">
  <h2 id="map-h">Mastery map</h2>
  <p>
    Each mark is one idea. Ideas to its left are the basics it builds on. Shape and text show your state, not
    colour alone: an open circle is not started, a hatched diamond is learning, a solid square is mastered.
    The states are estimates from your answers on this device.
  </p>
  <p data-map-summary class="map-summary">
    {published.length} ideas in total.
  </p>
  <div class="map-filter js-only">
    <label for="map-module">Show</label>
    <select id="map-module" data-map-filter>
      <option value="all">All modules</option>
      {mods.map((m) => (
        <option value={m}>{`${m}. ${moduleNames[m] ?? `Module ${m}`}`}</option>
      ))}
    </select>
  </div>
  <div
    class="map-scroll"
    tabindex="0"
    role="region"
    aria-label="Mastery map. It scrolls sideways. The same information is in the list below."
  >
    <svg
      class="map-svg"
      width={layout.width}
      height={layout.height}
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      role="group"
      aria-label="Concept graph"
    >
      <defs>
        <pattern
          id="map-hatch"
          width="6"
          height="6"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <rect width="6" height="6" fill="var(--surface)"></rect>
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--accent)" stroke-width="3"></line>
        </pattern>
      </defs>
      <g class="map-edges" aria-hidden="true">
        {layout.edges.map((e) => {
          const a = pos.get(e.from)!;
          const b = pos.get(e.to)!;
          const x1 = a.x + NODE_W;
          const y1 = a.y + mid;
          const x2 = b.x;
          const y2 = b.y + mid;
          const dx = (COL_W - NODE_W) / 2 + 20;
          return (
            <path
              d={`M${x1} ${y1} C${x1 + dx} ${y1} ${x2 - dx} ${y2} ${x2} ${y2}`}
              data-from-module={byId.get(e.from)!.module}
              data-to-module={byId.get(e.to)!.module}
            />
          );
        })}
      </g>
      {layout.nodes.map((n) => {
        const c = byId.get(n.id)!;
        const t = topics[c.id];
        const inner = (
          <>
            <title>{`${c.label}. ${c.summary}`}</title>
            <rect class="node-hit" x={n.x} y={n.y} width={NODE_W} height={ROW_H - 4} rx="4"></rect>
            <circle class="shape shape-new" cx={n.x + 14} cy={n.y + mid - 2} r="7"></circle>
            <path
              class="shape shape-learning"
              d={`M${n.x + 14} ${n.y + mid - 10} l8 8 l-8 8 l-8 -8 z`}
            ></path>
            <rect class="shape shape-mastered" x={n.x + 7} y={n.y + mid - 9} width="14" height="14"></rect>
            <svg x={n.x + 30} y={n.y} width={NODE_W - 34} height={ROW_H - 4}>
              <text x="0" y={mid + 2} class="node-label">
                {c.label}
              </text>
            </svg>
          </>
        );
        const label = `${c.label}, module ${c.module}, not started`;
        return t ? (
          <a
            href={t.href}
            aria-label={label}
            data-concept={c.id}
            data-module={c.module}
            data-state="new"
            class="map-node"
          >
            {inner}
          </a>
        ) : (
          <g
            role="img"
            aria-label={label}
            data-concept={c.id}
            data-module={c.module}
            data-state="new"
            class="map-node"
          >
            {inner}
          </g>
        );
      })}
    </svg>
  </div>

  <h2 id="list-h">The same map as a list</h2>
  {mods.map((m) => (
    <section class="map-list" data-module-section={m} aria-labelledby={`ml-${m}`}>
      <h3 id={`ml-${m}`}>{`${m}. ${moduleNames[m] ?? `Module ${m}`}`}</h3>
      <ul>
        {published
          .filter((c) => c.module === m)
          .map((c) => (
            <li data-concept={c.id} data-state="new" data-module={c.module}>
              {topics[c.id] ? <a href={topics[c.id]!.href}>{c.label}</a> : <span>{c.label}</span>}
              <span class="map-state"> (not started)</span>
              {c.prerequisites.length > 0 && (
                <span class="map-pre">
                  {' '}
                  builds on {c.prerequisites.map((p) => byId.get(p)?.label ?? p).join(', ')}
                </span>
              )}
            </li>
          ))}
      </ul>
    </section>
  ))}
</section>

<style is:global>
  .map-scroll {
    overflow: auto;
    max-width: 100%;
    max-height: 70vh;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .map-svg {
    display: block;
  }
  .map-edges path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
    opacity: 0.55;
  }
  .map-node .node-hit {
    fill: transparent;
  }
  .map-node:hover .node-hit,
  a.map-node:focus-visible .node-hit {
    fill: var(--surface-2);
    stroke: var(--focus);
    stroke-width: 2;
  }
  a.map-node:focus-visible {
    outline: none;
  }
  .node-label {
    fill: var(--text);
    font: 12px var(--font-mono);
  }
  .shape {
    display: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .shape-new {
    fill: none;
    stroke-dasharray: 3 2;
  }
  .shape-learning {
    fill: url(#map-hatch);
  }
  .shape-mastered {
    fill: var(--accent);
  }
  [data-state='new'] > .shape-new,
  [data-state='learning'] > .shape-learning,
  [data-state='mastered'] > .shape-mastered {
    display: inline;
  }
  .map-filter {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-3) 0;
  }
  .map-filter select {
    min-height: var(--target);
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0 var(--space-3);
  }
  .map-list ul {
    padding-left: var(--space-4);
  }
  .map-list li {
    margin: var(--space-1) 0;
  }
  .map-pre,
  .map-state {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .map-summary {
    color: var(--text-muted);
  }
</style>
