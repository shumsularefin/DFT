---
// Carries a text label and a distinct shape, so meaning never depends on colour alone.
import './Badge.css';
import { BADGE_LABELS, BADGE_SHAPES, type BadgeVariant } from '../../lib/badges';
interface Props {
  variant: BadgeVariant;
}
const { variant } = Astro.props;
---

<span class={`badge badge-${variant}`}>
  <svg
    viewBox="0 0 12 12"
    width="12"
    height="12"
    aria-hidden="true"
    focusable="false"
    set:html={BADGE_SHAPES[variant]}
  />
  {BADGE_LABELS[variant]}
</span>
