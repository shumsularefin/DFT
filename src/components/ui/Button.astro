---
// Styles for .btn live in src/styles/base.css so plain <button class="btn"> in scripts matches.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  [attr: string]: unknown;
}
const { variant = 'secondary', type = 'button', disabled = false, class: cls, ...rest } = Astro.props;
---

<button class:list={['btn', `btn-${variant}`, cls]} type={type} disabled={disabled} {...rest}>
  <slot />
</button>
