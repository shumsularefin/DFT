---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import plexRegular from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  pageClass?: 'content' | 'island' | 'tool';
}
const { title, description = SITE.tagline, pageClass = 'content' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-page-class={pageClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={plexRegular} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Set the stored theme before first paint. Without storage or JS, prefers-color-scheme decides.
      try {
        // Same envelope as src/lib/storage.ts: { v: 1, data: 'light' | 'dark' }
        const e = JSON.parse(localStorage.getItem('dft:theme'));
        if (e && e.v === 1 && (e.data === 'light' || e.data === 'dark'))
          document.documentElement.dataset.theme = e.data;
      } catch {
        /* storage unavailable: keep the system theme */
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f3a5f" />
    <link rel="canonical" href={canonical.href} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<script>
  // Production only, after load, and only where service workers exist (D-010).
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }
</script>
